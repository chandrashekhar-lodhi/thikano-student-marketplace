# GEMINI_API_KEY: Optional for AI Studio runtime if any AI features are added later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected in hosted environments.
APP_URL="http://localhost:3000"

# SUPABASE CREDENTIALS (Required for live Supabase Auth, Database & Storage)
# Find these in your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# GOOGLE MAPS PLATFORM (Required for Google Maps & Places API New)
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"
